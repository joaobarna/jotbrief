{
  "manifest_version": 3,
  "name": "JB - Jot Brief: nomes no Meet",
  "version": "0.2.0",
  "description": "Avisa o app JB - Jot Brief (no seu computador) quem está falando no Google Meet, para dar nome às vozes.",
  "permissions": ["alarms"],
  "host_permissions": ["http://127.0.0.1:47821/*"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "JB - Jot Brief",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
